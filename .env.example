# 拷贝本文件为 .env.local 并填上真实值（.env.local 被 .gitignore 屏蔽）。
# 这些变量供以下场景：
#   1. 本地脚本 scripts/evaluate-forecasts.mjs 读 process.env.GITHUB_TOKEN
#   2. 构建脚本 scripts/build-n8n-code.mjs 生成 n8n/*.local.js

# fine-grained PAT，仅 aq-forecast 仓库的 Contents: Read/Write
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

GITHUB_OWNER=weiweicf66-cmd
GITHUB_REPO=aq-forecast
GITHUB_BRANCH=main
